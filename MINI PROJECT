<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BodyCheck - Step by Step Health Calculator</title>
<style>
  body { margin: 0; font-family: "Trebuchet MS", Arial, sans-serif; background-color: #e3f2fd; }
  /* blue header */
  header { background: linear-gradient(135deg, #1976d2, #26c6da); color: white; text-align: center; padding: 25px 10px 60px 10px; }
  header h1 { margin: 0; font-size: 28px; }
  header p { margin: 6px 0 0 0; font-size: 14px; }
  /* white card that overlaps the header */
  .app { max-width: 440px; margin: -40px auto 30px auto; background-color: white; padding: 22px; border-radius: 14px; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15); }
  /* step dots */
  .dots { text-align: center; margin-bottom: 18px; }
  .dot { display: inline-block; width: 28px; height: 28px; line-height: 28px; margin: 0 6px; border-radius: 50%; background-color: #cfd8dc; color: white; font-size: 13px; font-weight: bold; }
  .dot.on { background-color: #1976d2; }
  h2 { margin-top: 0; font-size: 20px; color: #1976d2; }
  label { display: block; margin: 12px 0 4px 0; font-size: 14px; color: #455a64; }
  input[type="text"], select { width: 100%; box-sizing: border-box; padding: 10px; font-size: 16px; border: 2px solid #b0bec5; border-radius: 8px; }
  /* gender buttons */
  .gender-row { display: flex; gap: 10px; }
  .gender-btn { flex: 1; padding: 14px; font-size: 16px; background-color: white; border: 2px solid #b0bec5; border-radius: 8px; cursor: pointer; }
  .gender-btn.chosen { background-color: #1976d2; border-color: #1976d2; color: white; }
  .error { color: #d32f2f; font-size: 13px; min-height: 18px; margin-top: 10px; }
  /* back and next buttons */
  .buttons { display: flex; gap: 10px; margin-top: 12px; }
  .buttons button { flex: 1; padding: 12px; font-size: 16px; border: none; border-radius: 8px; cursor: pointer; }
  .next { background-color: #1976d2; color: white; }
  .back { background-color: #cfd8dc; color: #263238; }
  /* only step 1 is visible at the start */
  .step { display: none; }
  #step1 { display: block; }
  /* semicircle gauge */
  .gauge-wrap { position: relative; width: 240px; height: 135px; margin: 0 auto; overflow: hidden; }
  .arc { position: relative; width: 240px; height: 240px; border-radius: 50%;
    background: conic-gradient(from -90deg, #4a90d9 0deg 51deg, #3cb371 51deg 90deg, #f0a830 90deg 120deg, #d64545 120deg 180deg, transparent 180deg); }
  /* white circle in the middle makes it a ring */
  .arc::after { content: ""; position: absolute; top: 45px; left: 45px; width: 150px; height: 150px; border-radius: 50%; background-color: white; }
  #needle { position: absolute; left: 118px; top: 20px; width: 4px; height: 100px; background-color: #263238; border-radius: 2px;
    transform-origin: bottom center; transform: rotate(-90deg); transition: transform 0.9s ease; }
  .hub { position: absolute; left: 110px; top: 112px; width: 20px; height: 20px; border-radius: 50%; background-color: #263238; }
  .scale { width: 240px; margin: 2px auto 0 auto; display: flex; justify-content: space-between; font-size: 11px; color: #78909c; }
  #bmiNumber { text-align: center; font-size: 44px; font-weight: bold; margin: 6px 0 0 0; }
  #bmiWord { text-align: center; font-size: 20px; font-weight: bold; margin: 0 0 14px 0; }
  .row { display: flex; justify-content: space-between; padding: 10px 4px; border-bottom: 1px solid #eceff1; font-size: 15px; }
  .row b { color: #1976d2; }
  .goal-row { background-color: #e3f2fd; border-radius: 8px; padding: 12px; margin-top: 10px; text-align: center; }
  .goal-row .big { font-size: 26px; font-weight: bold; color: #1976d2; }
  .note { font-size: 11px; color: #90a4ae; text-align: center; margin-top: 14px; }
</style>
</head>
<body>

<header>
  <h1>BodyCheck</h1>
  <p>Answer 3 quick steps to see your BMI, calories and ideal weight</p>
</header>

<div class="app">

  <div class="dots">
    <span class="dot on" id="dot1">1</span><span class="dot" id="dot2">2</span>
    <span class="dot" id="dot3">3</span><span class="dot" id="dot4">&#10003;</span>
  </div>

  <!-- STEP 1 -->
  <div class="step" id="step1">
    <h2>About you</h2>
    <label>Gender</label>
    <div class="gender-row">
      <button type="button" class="gender-btn chosen" id="maleBtn" onclick="chooseGender('male')">Male</button>
      <button type="button" class="gender-btn" id="femaleBtn" onclick="chooseGender('female')">Female</button>
    </div>
    <label for="age">Age (years)</label>
    <input type="text" id="age" placeholder="e.g. 18">
    <div class="error" id="error1"></div>
    <div class="buttons"><button class="next" onclick="nextStep()">Next</button></div>
  </div>

  <!-- STEP 2 -->
  <div class="step" id="step2">
    <h2>Your body</h2>
    <label for="height">Height (cm)</label>
    <input type="text" id="height" placeholder="e.g. 170">
    <label for="weight">Weight (kg)</label>
    <input type="text" id="weight" placeholder="e.g. 65">
    <div class="error" id="error2"></div>
    <div class="buttons">
      <button class="back" onclick="backStep()">Back</button>
      <button class="next" onclick="nextStep()">Next</button>
    </div>
  </div>

  <!-- STEP 3 -->
  <div class="step" id="step3">
    <h2>Your lifestyle</h2>
    <label for="activity">How active are you?</label>
    <select id="activity">
      <option value="1.2">Sedentary (no exercise)</option>
      <option value="1.375">Light (1-3 days a week)</option>
      <option value="1.55">Moderate (3-5 days a week)</option>
      <option value="1.725">Active (6-7 days a week)</option>
      <option value="1.9">Very active (daily hard exercise)</option>
    </select>
    <label for="goal">Your goal</label>
    <select id="goal">
      <option value="lose">Lose weight</option>
      <option value="maintain" selected>Maintain weight</option>
      <option value="gain">Gain weight</option>
    </select>
    <div class="buttons">
      <button class="back" onclick="backStep()">Back</button>
      <button class="next" onclick="nextStep()">See my result</button>
    </div>
  </div>

  <!-- STEP 4: RESULT -->
  <div class="step" id="step4">
    <h2>Your result</h2>
    <div class="gauge-wrap">
      <div class="arc"></div><div id="needle"></div><div class="hub"></div>
    </div>
    <div class="scale"><span>10</span><span>BMI</span><span>40</span></div>

    <p id="bmiNumber">0</p>
    <p id="bmiWord"></p>

    <div class="row"><span>Ideal weight</span><b id="ideal"></b></div>
    <div class="row"><span>Healthy weight range</span><b id="healthy"></b></div>
    <div class="row"><span>BMR (at rest)</span><b id="bmr"></b></div>
    <div class="row"><span>Maintain weight</span><b id="maintain"></b></div>

    <div class="goal-row">
      <div id="goalName"></div>
      <div class="big" id="goalCal"></div>
      <div>calories per day</div>
    </div>

    <div class="buttons"><button class="back" onclick="startAgain()">Start again</button></div>
    <p class="note">For learning only. BMI does not measure body fat. Ask a doctor for medical advice.</p>
  </div>

</div>

<script>
  var currentStep = 1;
  var gender = "male";

  // show only one step at a time
  function showStep(number) {
    for (var i = 1; i <= 4; i++) {
      document.getElementById("step" + i).style.display = "none";
      document.getElementById("dot" + i).className = "dot";
    }
    document.getElementById("step" + number).style.display = "block";
    for (var j = 1; j <= number; j++) {
      document.getElementById("dot" + j).className = "dot on";   // colour the dots up to this step
    }
    currentStep = number;
  }

  // gender buttons
  function chooseGender(value) {
    gender = value;
    document.getElementById("maleBtn").className = "gender-btn";
    document.getElementById("femaleBtn").className = "gender-btn";
    document.getElementById(value + "Btn").className = "gender-btn chosen";
  }

  // validation: returns an error message, or "" if the value is fine
  function checkNumber(id, min, max, name) {
    var box = document.getElementById(id);
    var text = box.value.trim();
    var message = "";

    if (text == "") {
      message = "Please enter your " + name + ".";
    } else if (isNaN(text)) {
      message = "Your " + name + " must be a number.";
    } else if (Number(text) < min || Number(text) > max) {
      message = "Your " + name + " must be between " + min + " and " + max + ".";
    }

    if (message == "") {
      box.style.borderColor = "#2e7d32";   // green = OK
    } else {
      box.style.borderColor = "#d32f2f";   // red = wrong
    }
    return message;
  }

  // next and back
  function nextStep() {
    var message = "";

    if (currentStep == 1) {
      message = checkNumber("age", 15, 100, "age");
      document.getElementById("error1").innerHTML = message;
    }
    if (currentStep == 2) {
      message = checkNumber("height", 100, 250, "height");
      if (message == "") {
        message = checkNumber("weight", 20, 300, "weight");
      }
      document.getElementById("error2").innerHTML = message;
    }

    if (message != "") {
      return;   // there is an error, so stay on this step
    }
    if (currentStep == 3) {
      calculate();
    }
    showStep(currentStep + 1);
  }

  function backStep() {
    showStep(currentStep - 1);
  }

  function startAgain() {
    var ids = ["age", "height", "weight"];
    for (var i = 0; i < ids.length; i++) {
      document.getElementById(ids[i]).value = "";
      document.getElementById(ids[i]).style.borderColor = "#b0bec5";
    }
    document.getElementById("needle").style.transform = "rotate(-90deg)";
    chooseGender("male");
    showStep(1);
  }

  // calculation
  function calculate() {
    var age = Number(document.getElementById("age").value);
    var height = Number(document.getElementById("height").value);
    var weight = Number(document.getElementById("weight").value);
    var activity = Number(document.getElementById("activity").value);
    var goal = document.getElementById("goal").value;

    // BMI = weight / (height in metres x height in metres)
    var meters = height / 100;
    var bmi = weight / (meters * meters);

    var word = "Obese";
    var colour = "#d64545";
    if (bmi < 18.5) {
      word = "Underweight";
      colour = "#4a90d9";
    } else if (bmi < 25) {
      word = "Normal weight";
      colour = "#2e9e5e";
    } else if (bmi < 30) {
      word = "Overweight";
      colour = "#d98f00";
    }

    // ideal weight (Devine formula) and healthy range
    var extraInches = height / 2.54 - 60;
    if (extraInches < 0) {
      extraInches = 0;
    }
    var ideal = 50 + 2.3 * extraInches;
    if (gender == "female") {
      ideal = 45.5 + 2.3 * extraInches;
    }
    var low = 18.5 * meters * meters;
    var high = 24.9 * meters * meters;

    // calories (BMR x activity)
    var bmr = 10 * weight + 6.25 * height - 5 * age + 5;
    if (gender == "female") {
      bmr = bmr - 166;
    }
    var maintain = bmr * activity;

    var goalCal = maintain;
    var goalText = "To maintain weight eat about";
    if (goal == "lose") {
      goalCal = maintain - 500;
      goalText = "To lose weight eat about";
    }
    if (goal == "gain") {
      goalCal = maintain + 500;
      goalText = "To gain weight eat about";
    }

    // show the answers
    document.getElementById("bmiNumber").innerHTML = bmi.toFixed(1);
    document.getElementById("bmiNumber").style.color = colour;
    document.getElementById("bmiWord").innerHTML = word;
    document.getElementById("bmiWord").style.color = colour;
    document.getElementById("ideal").innerHTML = ideal.toFixed(1) + " kg";
    document.getElementById("healthy").innerHTML = low.toFixed(1) + " - " + high.toFixed(1) + " kg";
    document.getElementById("bmr").innerHTML = Math.round(bmr) + " cal";
    document.getElementById("maintain").innerHTML = Math.round(maintain) + " cal";
    document.getElementById("goalName").innerHTML = goalText;
    document.getElementById("goalCal").innerHTML = Math.round(goalCal);

    // turn the needle: BMI 10 = -90 degrees, BMI 40 = +90 degrees
    var percent = (bmi - 10) / 30;
    if (percent < 0) {
      percent = 0;
    }
    if (percent > 1) {
      percent = 1;
    }
    document.getElementById("needle").style.transform = "rotate(" + (percent * 180 - 90) + "deg)";
  }
</script>

</body>
</html>
